# Docker deploy config (copy to .env)
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Web UI exposure. 127.0.0.1 keeps it on this host; use 0.0.0.0 or one interface IP to expose it.
ARTEX_BIND=127.0.0.1
# Token that /setup requires to set the first admin password. Leave empty to have a random
# one printed to the log on start (docker compose logs artex | grep "setup token").
ARTEX_SETUP_TOKEN=

# LLM (set one or both; leave empty and configure them in the UI instead)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
